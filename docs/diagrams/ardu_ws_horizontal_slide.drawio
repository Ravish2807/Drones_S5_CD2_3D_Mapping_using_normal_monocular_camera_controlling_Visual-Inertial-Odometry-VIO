        <mxCell id="m0_s1" value="&lt;b&gt;1. Outer Loop PID&lt;/b&gt;&lt;br/&gt;ep = pd - p, ev = vd - v&lt;br/&gt;ad = p̈d + Kp ep + Kv ev&lt;br/&gt;clamp(ad, vmax=1.0m/s)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="529" y="160" width="175" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="m0_s2" value="&lt;b&gt;2. Attitude Generator&lt;/b&gt;&lt;br/&gt;Fd = m(ad - g)&lt;br/&gt;b3d = Fd / ||Fd||&lt;br/&gt;Rd = [b1d, b2d, b3d] ∈ SO(3)&lt;br/&gt;Converts to quat qd" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="720" y="160" width="175" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="m0_s3" value="&lt;b&gt;3. SO(3) Inner Loop&lt;/b&gt;&lt;br/&gt;eR = ½(Rdᵀ R - Rᵀ Rd)ᵛ&lt;br/&gt;eω = ω - Rᵀ Rd ωd&lt;br/&gt;τ = -KR eR - KΩ eω&lt;br/&gt;Geometric on manifold" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="911" y="160" width="175" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="m0_out" value="&lt;b&gt;4. Output Synthesis&lt;/b&gt;&lt;br/&gt;Publish /ap/cmd_vel @ 50 Hz&lt;br/&gt;Telemetry: ep, ev, eR, τ&lt;br/&gt;Real-Time Lie Group" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#059669;fontSize=11;fontColor=#166534;fontStyle=1;">
          <mxGeometry x="1102" y="160" width="175" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="e_m0_12" value="" edge="1" parent="1" source="m0_s1" target="m0_s2" style="strokeColor=#059669;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_m0_23" value="" edge="1" parent="1" source="m0_s2" target="m0_s3" style="strokeColor=#059669;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_m0_34" value="" edge="1" parent="1" source="m0_s3" target="m0_out" style="strokeColor=#059669;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1_s1" value="&lt;b&gt;1. Error-State EKF&lt;/b&gt;&lt;br/&gt;12-State δx = [δp,δv,δθ,δω]ᵀ&lt;br/&gt;R ← R · Exp(δθ)&lt;br/&gt;P ← (I-KH)P(I-KH)ᵀ+KRKᵀ" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="529" y="415" width="142" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="m1_s2" value="&lt;b&gt;2. Outer Loop&lt;/b&gt;&lt;br/&gt;Runs on estimator: p̂, v̂&lt;br/&gt;ep = pd - p̂, ev = vd - v̂&lt;br/&gt;ad = p̈d + Kp ep + Kv ev" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="687" y="415" width="142" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="m1_s3" value="&lt;b&gt;3. Attitude Gen&lt;/b&gt;&lt;br/&gt;Fd = m(ad - g)&lt;br/&gt;b3d = Fd / ||Fd||, Rd ∈ SO(3)&lt;br/&gt;Thrust: T = Fd · (R e3)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="845" y="415" width="142" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="m1_s4" value="&lt;b&gt;4. SO(3) Geometric&lt;/b&gt;&lt;br/&gt;eR = ½(Rdᵀ R - Rᵀ Rd)ᵛ&lt;br/&gt;τ = -KR eR - KΩ eω + ω×Jω&lt;br/&gt;Singularity-free &amp;gt;90° tilt" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="1003" y="415" width="142" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="m1_out" value="&lt;b&gt;5. Output Synthesis&lt;/b&gt;&lt;br/&gt;/ap/v1/cmd_vel @ 50 Hz&lt;br/&gt;controller_type = MODEL_1&lt;br/&gt;Covariance broadcast" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;fontColor=#92400E;fontStyle=1;">
          <mxGeometry x="1161" y="415" width="142" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="e_m1_12" value="" edge="1" parent="1" source="m1_s1" target="m1_s2" style="strokeColor=#D97706;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_m1_23" value="" edge="1" parent="1" source="m1_s2" target="m1_s3" style="strokeColor=#D97706;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_m1_34" value="" edge="1" parent="1" source="m1_s3" target="m1_s4" style="strokeColor=#D97706;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_m1_45" value="" edge="1" parent="1" source="m1_s4" target="m1_out" style="strokeColor=#D97706;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2_s1" value="&lt;b&gt;1. State Deviation&lt;/b&gt;&lt;br/&gt;xk = [p-pd; v; Log(R); ω]&lt;br/&gt;uk = [T-mg0; τ] ∈ ℝ⁴&lt;br/&gt;Trim: mg0 = 14.7 N" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="529" y="680" width="142" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="m2_s2" value="&lt;b&gt;2. DMDc System ID&lt;/b&gt;&lt;br/&gt;[A B] = X⁺ [X; U]†&lt;br/&gt;Snapshot regression&lt;br/&gt;Blended hover prior" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="687" y="680" width="142" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="m2_opt" value="&lt;b&gt;3. Optimal Synthesis&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;LQR:&lt;/b&gt; DARE P = AᵀPA + Q, u = -K xk&lt;br/&gt;• &lt;b&gt;MPC:&lt;/b&gt; N=25 (1s), OSQP solver (0.42 ms)&lt;br/&gt;Bounds: 5N ≤ T ≤ 25N, |τ| ≤ 0.5Nm" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="845" y="680" width="175" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="m2_syn" value="&lt;b&gt;4. Synthesis&lt;/b&gt;&lt;br/&gt;u = utrim + u*&lt;br/&gt;Map optimal [T; τ]&lt;br/&gt;to body velocity" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=10.5;fontColor=#0F172A;align=left;spacingLeft=6;">
          <mxGeometry x="1036" y="680" width="125" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="m2_out" value="&lt;b&gt;5. Output&lt;/b&gt;&lt;br/&gt;cmd_vel body&lt;br/&gt;MODEL_2_DMDC&lt;br/&gt;Residual monitor" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;fontColor=#5B21B6;fontStyle=1;">
          <mxGeometry x="1177" y="680" width="126" height="195" as="geometry"/>
