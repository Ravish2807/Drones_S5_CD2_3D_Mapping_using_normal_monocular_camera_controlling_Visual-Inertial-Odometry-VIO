        <mxCell id="c1_veh" value="&lt;b&gt;📡 Vehicle State (DDS) [50 Hz]&lt;/b&gt;&lt;br/&gt;• /ap/pose (ENU Map): Pos [x,y,z], Quat [qx,qy,qz,qw]&lt;br/&gt;• /ap/twist (FLU Body): Linear [vx,vy,vz], Angular [p,q,r]&lt;br/&gt;• /ap/v1/status: Armed, GUIDED, EKF3 health" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="14" y="130" width="230" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="c1_tel" value="&lt;b&gt;🎮 Pilot Teleop (Gamepad) [50 Hz]&lt;/b&gt;&lt;br/&gt;• 8BitDo gamepad → teleop_cmd&lt;br/&gt;• Axes: Vx, Vy, Vz (0.5..2.0 m/s), yaw_rate&lt;br/&gt;• Buttons: Y=GUIDED, A=ARM, X=TAKEOFF, B=HOVER" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="14" y="320" width="230" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="c1_mis" value="&lt;b&gt;🎯 Mission Targets&lt;/b&gt;&lt;br/&gt;• Web UI at http://localhost:8000&lt;br/&gt;• Setpoint: /target_pose&lt;br/&gt;• Services: /ap/arm_motors, /ap/takeoff" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="14" y="510" width="230" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="c1_cfg" value="&lt;b&gt;⚙️ Config &amp;amp; Payload&lt;/b&gt;&lt;br/&gt;• controller.yaml: mass 1.5kg, vmax 1.0m/s, tilt ≤ 20°&lt;br/&gt;• /camera/image_raw (640x480 RGB @ 30 FPS)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="14" y="695" width="230" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="c2_api" value="&lt;b&gt;🔌 ArduPilotInterface [50 Hz]&lt;/b&gt;&lt;br/&gt;• Subscribes DDS pose, twist, status&lt;br/&gt;• Timeout check: dt &amp;lt; 0.20s&lt;br/&gt;• Publishes body velocity command" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0891B2;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="264" y="130" width="245" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="c2_val" value="&lt;b&gt;State Valid?&lt;/b&gt;&lt;br/&gt;pos != NaN/Inf &amp;amp; dt &amp;lt; 0.2s" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=11;fontColor=#92400E;">
          <mxGeometry x="264" y="275" width="130" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c2_skp" value="&lt;b&gt;⚠️ Skip Cycle&lt;/b&gt;&lt;br/&gt;Log WARN &amp;amp; zero cmd" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=10;fontColor=#991B1B;">
          <mxGeometry x="410" y="275" width="99" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c2_ada" value="&lt;b&gt;🔄 State Adapter [Lie SO(3)]&lt;/b&gt;&lt;br/&gt;• Quat → SO(3) matrix R ∈ ℝ³ˣ³ (so3_exp)&lt;br/&gt;• Frame transform: ENU map ↔ FLU body&lt;br/&gt;• Current yaw: ψ = atan2(R₁₀, R₀₀)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0891B2;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="264" y="365" width="245" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c2_tgt" value="&lt;b&gt;🎯 Target Manager [Arbiter]&lt;/b&gt;&lt;br/&gt;• Inputs: teleop_cmd, waypoint, YAML&lt;br/&gt;• State: pd, vd, ad, ψ̇d&lt;br/&gt;• Auto position hold lock when sticks centered" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0891B2;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="264" y="520" width="245" height="145" as="geometry"/>
        </mxCell>
