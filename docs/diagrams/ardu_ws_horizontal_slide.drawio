        <mxCell id="c4_arb" value="&lt;b&gt;⚖️ Pilot / Autonomy Arbiter&lt;/b&gt;&lt;br/&gt;• Stick deflection &amp;gt; 0.02 → Manual&lt;br/&gt;• Stick centered → Auto waypoint lock&lt;br/&gt;• Bumpless smooth transfer" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
          <mxGeometry x="1334" y="130" width="245" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c4_saf" value="&lt;b&gt;🛡️ SafetyManager [Validation]&lt;/b&gt;&lt;br/&gt;• Rejects NaN / Inf → Safe zero cmd&lt;br/&gt;• Clamps: vel ≤ 1.0 m/s, tilt ≤ 20°&lt;br/&gt;• Ground-effect clamp: zero drift if Z &amp;lt; 1.5m" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=8;">
