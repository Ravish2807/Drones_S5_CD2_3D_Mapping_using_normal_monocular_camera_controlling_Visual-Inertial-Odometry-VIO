  <diagram id="canva_slide_pipeline" name="Drones Controller Architecture Pipeline">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr" value="&lt;b&gt;🚁 Drones Controller — Autonomous Flight Control Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#94A3B8;'&gt;Geometric SO(3), Error-State EKF &amp; DMDc Optimal Control Integrated with ArduPilot DDS SITL &amp; Gazebo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1880" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="qk" value="&lt;b&gt;🛠️ QUICKSTART:&lt;/b&gt; 1. colcon build &amp;nbsp;➔&amp;nbsp; 2. ros2 launch ardupilot_gz_bringup runway.launch.py &amp;nbsp;➔&amp;nbsp; 3. ros2 launch drones_controller controller.launch.py model:=0|1|2 &amp;nbsp;➔&amp;nbsp; 4. python3 bridge_server.py (:8000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0369A1;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="72" width="1880" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c1_veh" value="&lt;b&gt;📡 Vehicle State (AP_DDS 50 Hz)&lt;/b&gt;&lt;br&gt;• /ap/pose: Pos [x,y,z], Quat q&lt;br&gt;• /ap/twist: Linear &amp; Angular vel&lt;br&gt;• /ap/vl/status: Armed &amp; GUIDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="210" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c1_tel" value="&lt;b&gt;🎮 Pilot Teleop (Manual)&lt;/b&gt;&lt;br&gt;• 8BitDo gamepad ➔ teleop_cmd&lt;br&gt;• Velocity sticks: Vx, Vy, Vz (1.0 m/s)&lt;br&gt;• Stick Deflection &gt; 0.02 (Override)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="395" width="210" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c1_mis" value="&lt;b&gt;🎯 Mission Targets (Auto)&lt;/b&gt;&lt;br&gt;• Web UI Setpoint: /target_pose&lt;br&gt;• Services: /ap/arm_motors, /ap/takeoff&lt;br&gt;• Target tolerance: 0.05m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="210" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c2_ada" value="&lt;b&gt;🔄 State &amp; Lie Adapter (50 Hz)&lt;/b&gt;&lt;br&gt;• Watchdog: Reject NaN &amp; Δt &lt; 0.2s&lt;br&gt;• Quat ➔ Rotation matrix R ∈ SO(3)&lt;br&gt;• ENU (map) ↔ FLU (body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0891B2;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="270" y="130" width="220" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c2_sw" value="&lt;b&gt;🔀 Select Controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:15px;color:#B45309;'&gt;&lt;b&gt;model := 0 | 1 | 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;3-Way Symmetrical Branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=3;fontColor=#92400E;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="395" width="220" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c2_tgt" value="&lt;b&gt;🎯 Trajectory Manager (Profiler)&lt;/b&gt;&lt;br&gt;• Smooth trajectory generation&lt;br&gt;• Blends sticks + auto waypoints&lt;br&gt;• Auto Position Hold on stick release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0891B2;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="270" y="660" width="220" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="m0_track" value="&lt;b&gt;🟢 MODEL 0: BASELINE CASCADED SO(3) (controller_node.py • 50 Hz)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="530" y="130" width="710" height="242" as="geometry"/>
        </mxCell>
        <mxCell id="m0_s1" value="&lt;b&gt;1. Outer-Loop Position PID&lt;/b&gt;&lt;br&gt;e_p = p_d - p, e_v = v_d - v&lt;br&gt;&lt;b&gt;a_d = p̈_d + K_p e_p + K_v e_v&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="545" y="175" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m0_s2" value="&lt;b&gt;2. SO(3) Attitude &amp; Torque&lt;/b&gt;&lt;br&gt;F_d = m(a_d - g e_3) ➔ R_d ∈ SO(3)&lt;br&gt;&lt;b&gt;τ = -K_R e_R - K_Ω e_ω&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="175" width="250" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m0_out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;/ap/cmd_vel&lt;/b&gt;&lt;br&gt;@ 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1045" y="175" width="180" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m1_track" value="&lt;b&gt;🟠 MODEL 1: ERROR-STATE EKF + SO(3) (model1_so3_controller.py • 50 Hz)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="530" y="395" width="710" height="242" as="geometry"/>
        </mxCell>
        <mxCell id="m1_s1" value="&lt;b&gt;1. 12-State Error-State EKF&lt;/b&gt;&lt;br&gt;δx = [δp, δv, δθ, δω]ᵀ ∈ ℝ¹²&lt;br&gt;&lt;b&gt;Joseph: P = (I-KH)P(I-KH)ᵀ + KRKᵀ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="545" y="440" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m1_s2" value="&lt;b&gt;2. Singularity-Free SO(3)&lt;/b&gt;&lt;br&gt;Filtered state feedback p̂, v̂&lt;br&gt;&lt;b&gt;Lie Error: ||R_dᵀR - I|| &lt; 10⁻¹⁶&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="440" width="250" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m1_out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;/ap/v1/cmd_vel&lt;/b&gt;&lt;br&gt;@ 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1045" y="440" width="180" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m2_track" value="&lt;b&gt;🟣 MODEL 2: DMDc SYSTEM ID + MPC/LQR (model2_dmdc_controller.py • 25 Hz)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="530" y="660" width="710" height="242" as="geometry"/>
        </mxCell>
        <mxCell id="m2_s1" value="&lt;b&gt;1. Online DMDc System ID&lt;/b&gt;&lt;br&gt;Dynamic Mode Decomposition:&lt;br&gt;&lt;b&gt;[A, B] = X' [X; U]† (Rank r=8)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="545" y="705" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m2_s2" value="&lt;b&gt;2. Optimal Control (MPC/LQR)&lt;/b&gt;&lt;br&gt;Discrete Riccati: P = AᵀPA + Q&lt;br&gt;&lt;b&gt;OSQP QP: u* = -K x_k + u_trim&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="705" width="250" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m2_out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;/ap/cmd_vel&lt;/b&gt;&lt;br&gt;@ 25 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1045" y="705" width="180" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="c4_saf" value="&lt;b&gt;🛡️ Safety Limits (Watchdog)&lt;/b&gt;&lt;br&gt;• Rejects NaN / Inf ➔ Zero vel&lt;br&gt;• Clamps: |v| ≤ 1.0 m/s • tilt ≤ 20°&lt;br&gt;• Hard Clamp: vmax=1.0 m/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="130" width="235" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c4_arb" value="&lt;b&gt;⚖️ Flight Arbiter (Priority 1)&lt;/b&gt;&lt;br&gt;• Stick &gt; 0.02 ➔ Manual Override&lt;br&gt;• Stick neutral ➔ Selected Model&lt;br&gt;• Priority: Stick &gt; Safety &gt; Auto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="395" width="235" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c4_gat" value="&lt;b&gt;🛫 Airborne Gate (Z ≥ 0.5m)&lt;/b&gt;&lt;br&gt;• Z &lt; 0.50m: Zero lateral drift&lt;br&gt;• Z ≥ 0.50m: Dispatch command&lt;br&gt;• Publish: /ap/cmd_vel @ 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="660" width="235" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c5_hud" value="&lt;b&gt;💻 ArduHUD Web UI (:8000)&lt;/b&gt;&lt;br&gt;• WebSocket dashboard at :8000&lt;br&gt;• Three.js 3D attitude &amp; gyro&lt;br&gt;• 30 FPS camera video feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1555" y="130" width="235" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c5_sit" value="&lt;b&gt;🌐 Gazebo + SITL (Physics)&lt;/b&gt;&lt;br&gt;• Iris quadcopter multi-body model&lt;br&gt;• Physics step @ 1000 Hz&lt;br&gt;• EKF3 24-State Fusion (IMU, Baro, GPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1555" y="395" width="235" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="c5_hw" value="&lt;b&gt;🖧 Hardware Target (Real Drone)&lt;/b&gt;&lt;br&gt;• Companion: Jetson Orin / RPi 5&lt;br&gt;• Pixhawk 6X / Cube Orange+&lt;br&gt;• ArduPilot 4.5+ Copter Firmware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2.5;fontColor=#0F172A;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1555" y="660" width="235" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="bot" value="&lt;b&gt;📍 WHERE IT IS USED &amp; REAL-WORLD DEPLOYMENT PIPELINE&lt;/b&gt;&lt;br&gt;• Autonomous Waypoint Tracking in GPS/GPS-denied &amp;bull; Direct Controller Benchmarking &amp;bull; Hardware Flight Stack (Pixhawk FCU + FastRTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#0369A1;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="980" width="1880" height="50" as="geometry"/>
        </mxCell>
