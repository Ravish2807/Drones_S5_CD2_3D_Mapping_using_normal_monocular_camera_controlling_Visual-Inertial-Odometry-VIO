<mxfile host="app.diagrams.net" modified="2026-10-20T19:00:00.000Z" agent="Antigravity" version="24.0.0" type="device"><diagram id="horizontal_pipeline" name="Drones Controller Horizontal Pipeline"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry" /></mxCell><mxCell id="title_bar" value="&lt;div style='text-align:center;'&gt;&lt;span style='font-size:20px;font-weight:800;color:#0F172A;letter-spacing:-0.5px;'&gt;Drones Controller — End-to-End Pipeline&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;color:#64748B;font-weight:600;'&gt;from monocular visual odometry to 3D mapping with visual-inertial odometry • closed-loop autonomous flight • Gazebo Harmonic&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="8" width="1320" height="42" as="geometry" /></mxCell><mxCell id="legend_bar" value="&lt;div style='font-size:9.5px;font-weight:700;color:#334155;text-align:center;'&gt;&lt;span style='display:inline-block;width:10px;height:10px;background:#64748B;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Deploy / Command &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#3B82F6;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Input &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#94A3B8;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Shared module &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#10B981;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Baseline SO(3) &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#F97316;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Model 1 &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#A855F7;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Model 2 &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#F59E0B;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Decision &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#14B8A6;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Output &amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block;width:10px;height:10px;background:#06B6D4;border-radius:2px;vertical-align:middle;margin-right:3px;'&gt;&lt;/span&gt; Telemetry&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1880" height="26" as="geometry" /></mxCell><mxCell id="col1_lane" value="&lt;b style='color:#1E293B;font-size:12px;'&gt;1. DEPLOY &amp;amp; RUNTIMES&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="86" width="250" height="926" as="geometry" /></mxCell><mxCell id="c1_start" value="&lt;b&gt;START&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="122" width="70" height="32" as="geometry" /></mxCell><mxCell id="c1_host" value="&lt;div style='font-size:10.5px;font-weight:700;color:#1E293B;'&gt;🖥️ Host machine&lt;/div&gt;&lt;div style='font-size:9.5px;color:#475569;line-height:13px;margin-top:2px;'&gt;• Ubuntu 22.04 LTS, ROS 2 Humble&lt;br/&gt;• CycloneDDS / FastDDS, dev tools&lt;br/&gt;• Git branch: &lt;code&gt;drones-controller&lt;/code&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="32" y="164" width="226" height="75" as="geometry" /></mxCell><mxCell id="c1_build" value="&lt;div style='font-size:10.5px;font-weight:700;color:#1E293B;'&gt;🔨 Build ws test (~/ardu_ws)&lt;/div&gt;&lt;div style='font-size:9px;color:#475569;line-height:13px;margin-top:2px;'&gt;&lt;code&gt;colcon build --packages-select drones_controller --symlink-install&lt;/code&gt;&lt;br/&gt;&lt;code&gt;colcon test&lt;/code&gt; (15/15 passed: Model 0, Model 1, Model 2)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="32" y="250" width="226" height="75" as="geometry" /></mxCell><mxCell id="c1_term1" value="&lt;div style='font-size:10.5px;font-weight:700;color:#1E293B;'&gt;💻 Terminal 1 - Simulator&lt;/div&gt;&lt;div style='font-size:9px;color:#475569;line-height:13px;margin-top:2px;'&gt;&lt;code&gt;ros2 launch ardupilot_gz_bringup iris_runway.launch.py&lt;/code&gt;&lt;br/&gt;Gazebo Harmonic + ArduPilot SITL JSON iris model&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="32" y="336" width="226" height="75" as="geometry" /></mxCell><mxCell id="c1_term2" value="&lt;div style='font-size:10.5px;font-weight:700;color:#1E293B;'&gt;💻 Terminal 2 - Controller&lt;/div&gt;&lt;div style='font-size:9px;color:#475569;line-height:13px;margin-top:2px;'&gt;&lt;code&gt;ros2 launch drones_controller controller.launch.py [model:=...]&lt;/code&gt;&lt;br/&gt;Runs controller: Baseline or model1_so3 or model2_dmdc&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="32" y="422" width="226" height="75" as="geometry" /></mxCell><mxCell id="c1_term4" value="&lt;div style='font-size:10.5px;font-weight:700;color:#1E293B;'&gt;💻 Terminal 4 - Ground station&lt;/div&gt;&lt;div style='font-size:9px;color:#475569;line-height:13px;margin-top:2px;'&gt;&lt;code&gt;python3 bridge_server.py&lt;/code&gt; (port 8000 WebSocket)&lt;br/&gt;Live &lt;code&gt;http://localhost:8000&lt;/code&gt; web dashboard&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="32" y="508" width="226" height="75" as="geometry" /></mxCell><mxCell id="c1_related" value="&lt;div style='font-size:10px;font-weight:700;color:#475569;'&gt;📦 Workspace Packages&lt;/div&gt;&lt;div style='font-size:9px;color:#64748B;line-height:13px;margin-top:2px;'&gt;• &lt;code&gt;drones_controller&lt;/code&gt; (Core)&lt;br/&gt;• &lt;code&gt;ardupilot_gz_bringup&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;ardupilot_gazebo&lt;/code&gt; plugins&lt;br/&gt;• &lt;code&gt;ros_gz_bridge&lt;/code&gt; (camera)&lt;br/&gt;• &lt;code&gt;Drones-Dashboard&lt;/code&gt; (UI)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="32" y="595" width="226" height="105" as="geometry" /></mxCell><mxCell id="col2_lane" value="&lt;b style='color:#1D4ED8;font-size:12px;'&gt;2. INPUTS &amp;amp; SENSORS&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1D4ED8;fontSize=11;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="284" y="86" width="280" height="926" as="geometry" /></mxCell><mxCell id="c2_veh" value="&lt;div style='font-size:11px;font-weight:700;color:#1E3A8A;'&gt;📡 Vehicle state (ArduPilot AP_DDS)&lt;/div&gt;&lt;div style='font-size:9.5px;color:#1E293B;line-height:14px;margin-top:3px;'&gt;• &lt;code&gt;/ap/pose&lt;/code&gt; (50 Hz, ENU map frame): Pos [x,y,z], Quat [qx,qy,qz,qw]&lt;br/&gt;• &lt;code&gt;/ap/twist&lt;/code&gt; (50 Hz, FLU body): Linear [vx,vy,vz], Angular [p,q,r]&lt;br/&gt;• &lt;code&gt;/ap/v1/status&lt;/code&gt; (10 Hz): Armed status, GUIDED/LAND mode, EKF3 health&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="296" y="122" width="256" height="115" as="geometry" /></mxCell><mxCell id="c2_teleop" value="&lt;div style='font-size:11px;font-weight:700;color:#1E3A8A;'&gt;🎮 Pilot teleop (optional)&lt;/div&gt;&lt;div style='font-size:9.5px;color:#1E293B;line-height:14px;margin-top:3px;'&gt;• 8BitDo gamepad / joystick / keyboard teleop&lt;br/&gt;• Topic: &lt;code&gt;/drones_controller/teleop_cmd&lt;/code&gt; (50 Hz)&lt;br/&gt;• Axes 0,1,2,5: Vx, Vy, Vz (0.5..2.0 m/s), yaw_rate (0.5 rad/s)&lt;br/&gt;• Buttons: Y=GUIDED, A=ARM, X=TAKEOFF 5M, B=BRAKE&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="296" y="250" width="256" height="115" as="geometry" /></mxCell><mxCell id="c2_yaml" value="&lt;div style='font-size:11px;font-weight:700;color:#1E3A8A;'&gt;⚙️ YAML config (loaded at launch)&lt;/div&gt;&lt;div style='font-size:9.5px;color:#1E293B;line-height:14px;margin-top:3px;'&gt;• &lt;code&gt;controller.yaml / model1_so3.yaml / model2_dmdc.yaml&lt;/code&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;mass 1.5kg, Kp, Kv, KR, KΩ, vmax 1.0 m/s, max tilt 20°,&lt;br/&gt;&amp;nbsp;&amp;nbsp;takeoff altitude 5.0m, state_timeout 0.20s, target [1.0, 0, 1.0]&lt;br/&gt;• &lt;code&gt;vehicle.yaml&lt;/code&gt;: J = diag(0.02, 0.02, 0.04) kg·m², g=9.81 m/s²&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="296" y="378" width="256" height="125" as="geometry" /></mxCell><mxCell id="c2_cmd" value="&lt;div style='font-size:11px;font-weight:700;color:#1E3A8A;'&gt;🎯 Operator mission commands&lt;/div&gt;&lt;div style='font-size:9.5px;color:#1E293B;line-height:14px;margin-top:3px;'&gt;• Web Dashboard at &lt;code&gt;http://localhost:8000&lt;/code&gt;&lt;br/&gt;• Active waypoint setpoint: &lt;code&gt;/drones_controller/target_pose&lt;/code&gt;&lt;br/&gt;• Service triggers: ARM (/ap/arm_motors), MODE (/ap/mode_switch), TAKEOFF (/ap/takeoff)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="296" y="516" width="256" height="110" as="geometry" /></mxCell><mxCell id="c2_cam" value="&lt;div style='font-size:11px;font-weight:700;color:#1E3A8A;'&gt;📹 Camera Stream (ros_gz_bridge)&lt;/div&gt;&lt;div style='font-size:9.5px;color:#1E293B;line-height:14px;margin-top:3px;'&gt;• &lt;code&gt;/camera/image_raw&lt;/code&gt; (30 FPS, 640×480 RGB)&lt;br/&gt;• Bridged from Gazebo camera sensor&lt;br/&gt;• Gimbal pitch/yaw pan-tilt PWM commands&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="296" y="638" width="256" height="95" as="geometry" /></mxCell><mxCell id="col3_lane" value="&lt;b style='color:#334155;font-size:12px;'&gt;3. COMMON FRONT-END&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=11;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="578" y="86" width="260" height="926" as="geometry" /></mxCell><mxCell id="c3_api" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;📦 ArduPilotInterface&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;Subscribes pose, twist, status (isolated QoS)&lt;br/&gt;Publishes velocity command to ArduPilot cmd_vel&lt;br/&gt;Tracks sensor timestamps (timeout: 0.20s)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="122" width="236" height="85" as="geometry" /></mxCell><mxCell id="c3_dec_valid" value="&lt;b&gt;State valid?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:8.5px;'&gt;pos != NaN, dt &amp;lt; 0.2s&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#EAB308;strokeWidth=1.5;fontColor=#854D0E;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="648" y="222" width="120" height="65" as="geometry" /></mxCell><mxCell id="c3_skip" value="&lt;div style='font-size:10px;font-weight:700;color:#DC2626;'&gt;⚠️ Skip control cycle&lt;/div&gt;&lt;div style='font-size:8.5px;color:#991B1B;line-height:12px;margin-top:2px;'&gt;State invalid / timed out&lt;br/&gt;Failsafe: publish zero velocity command&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="590" y="305" width="140" height="55" as="geometry" /></mxCell><mxCell id="c3_adapter" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;🔄 State Adapter&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;• Quat ➔ SO(3) rotation matrix R ∈ ℝ³ˣ³&lt;br/&gt;• Lie algebra maps: so3_exp &amp;amp; so3_log&lt;br/&gt;• Frame alignment: ENU map ↔ FLU base_link&lt;br/&gt;• Extracts current yaw: ψ = atan2(R[1,0], R[0,0])&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="380" width="236" height="100" as="geometry" /></mxCell><mxCell id="c3_tgt_mgr" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;🎯 Target Manager&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;• Target state: pd, vd, ad, ψd&lt;br/&gt;• Default hover waypoint: [1.0, 0.0, 1.0] m&lt;br/&gt;• Instant position lock: captures current&lt;br/&gt;&amp;nbsp;&amp;nbsp;drone coordinate when pilot sticks center&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="498" width="236" height="100" as="geometry" /></mxCell><mxCell id="c3_dec_model" value="&lt;b&gt;Which controller?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:8.5px;'&gt;launch param: &lt;code&gt;model:=...&lt;/code&gt;&lt;br/&gt;[0 / baseline, 1, 2]&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#EAB308;strokeWidth=1.5;fontColor=#854D0E;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="628" y="620" width="160" height="80" as="geometry" /></mxCell><mxCell id="col4_lane" value="&lt;b style='color:#4338CA;font-size:12px;'&gt;4. THREE CONTROLLER MODELS (Core Flight Engine)&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=6;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#4338CA;fontSize=11;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="852" y="86" width="480" height="926" as="geometry" /></mxCell><mxCell id="m0_card" value="&lt;div style='font-size:11.5px;font-weight:800;color:#065F46;'&gt;0 - SO(3) CASCADED CONTROLLER (baseline) &lt;span style='background:#D1FAE5;color:#065F46;font-size:9px;padding:2px 5px;border-radius:4px;'&gt;controller_node.py (50 Hz)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:9.5px;color:#064E3B;line-height:14px;margin-top:3px;'&gt;• &lt;b&gt;Position controller (outer loop):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;ep = pd - p, ev = vd - v | ad = p̈d + Kp ep + Kv ev&lt;br/&gt;&amp;nbsp;&amp;nbsp;Velocity saturation clamp: v_cmd = clamp(Kp ep + Kv ev, vmax=1.0 m/s)&lt;br/&gt;• &lt;b&gt;Attitude generator:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Desired force: Fd = m(ad - g) ➔ Thrust axis: b3d = Fd / ||Fd||&lt;br/&gt;&amp;nbsp;&amp;nbsp;Desired attitude: Rd = [b1d, b2d, b3d] ∈ SO(3), desired quat qd&lt;br/&gt;• &lt;b&gt;SO(3) geometric controller (inner loop):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Attitude error: eR = ½(Rdᵀ R - Rᵀ Rd)ᵛ, Rate error: eω = ω - Rᵀ Rd ωd&lt;br/&gt;&amp;nbsp;&amp;nbsp;Torque command: τ = -KR eR - KΩ eω [KR=(4,4,2), KΩ=(0.8,0.8,0.5)]&lt;br/&gt;• &lt;b&gt;Output:&lt;/b&gt; Publishes velocity command in map/base_link frame&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="864" y="122" width="456" height="190" as="geometry" /></mxCell><mxCell id="m1_card" value="&lt;div style='font-size:11.5px;font-weight:800;color:#9A3412;'&gt;MODEL 1 - ERROR-STATE EKF + GEOMETRIC SO(3) &lt;span style='background:#FFEDD5;color:#9A3412;font-size:9px;padding:2px 5px;border-radius:4px;'&gt;model1_so3_controller.py (50 Hz)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:9.5px;color:#7C2D12;line-height:14px;margin-top:3px;'&gt;• &lt;b&gt;Error-State EKF (Block 4):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;12-State error: δx = [δp, δv, δθ, δω]ᵀ ∈ ℝ¹² with Lie manifold addition R ← R·Exp(δθ)&lt;br/&gt;&amp;nbsp;&amp;nbsp;Rodrigues Exp &amp;amp; Log maps (machine precision roundtrip: 6.3×10⁻¹⁷)&lt;br/&gt;&amp;nbsp;&amp;nbsp;Discretization: F = I + A·Δt, Covariance propagation: P = F P Fᵀ + Q·Δt&lt;br/&gt;&amp;nbsp;&amp;nbsp;Joseph-form covariance update: P ← (I - KH)P(I - KH)ᵀ + KRnKᵀ&lt;br/&gt;• &lt;b&gt;Position controller (outer loop) - on estimator:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;ep = pd - p_hat, ev = vd - v_hat | ad = p̈d + Kp ep + Kv ev&lt;br/&gt;• &lt;b&gt;Attitude generator:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Desired force: Fd = m(ad - g) ➔ b3d = Fd / ||Fd|| ➔ Rd ∈ SO(3)&lt;br/&gt;&amp;nbsp;&amp;nbsp;Total thrust: T = Fd · (R e3)&lt;br/&gt;• &lt;b&gt;SO(3) geometric controller:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;eR = ½(Rdᵀ R - Rᵀ Rd)ᵛ, eω = ω - Rᵀ Rd ωd&lt;br/&gt;&amp;nbsp;&amp;nbsp;τ = -KR eR - KΩ eω + ω × Jω (singularity-free &amp;gt;90° tilt capability)&lt;br/&gt;• &lt;b&gt;Output:&lt;/b&gt; Publishes /ap/v1/cmd_vel, controller_type = MODEL_1_SO3_GEOMETRIC&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="864" y="322" width="456" height="260" as="geometry" /></mxCell><mxCell id="m2_card" value="&lt;div style='font-size:11.5px;font-weight:800;color:#6B21A8;'&gt;MODEL 2 - DMDC SYSTEM ID + LQR / MPC &lt;span style='background:#F3E8FF;color:#6B21A8;font-size:9px;padding:2px 5px;border-radius:4px;'&gt;model2_dmdc_controller.py (25 Hz)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:9.5px;color:#581C87;line-height:14px;margin-top:3px;'&gt;• &lt;b&gt;State deviation (Block 1):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;xk = [pk - pref; vk; Log(Rk); ωk] ∈ ℝ¹², uk = [Tk - mg0; τk] ∈ ℝ⁴ (mg0 = 14.715 N)&lt;br/&gt;• &lt;b&gt;DMDc system identification (Block 2):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Online snapshot regression: [A B] = X⁺ [X; U]† over rolling flight buffers&lt;br/&gt;&amp;nbsp;&amp;nbsp;Blended with analytical continuous hover linearization prior (Aphys, Bphys)&lt;br/&gt;• &lt;b&gt;Optimal Control Selection (mode:=lqr | mpc):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;[LQR Mode]:&lt;/b&gt; DARE Riccati: P = AᵀPA - AᵀPB(R + BᵀPB)⁻¹BᵀPA + Q&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Optimal feedback gain K = (R + BᵀPB)⁻¹BᵀPA ∈ ℝ⁴ˣ¹² ➔ u = -K xk&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;[MPC Mode]:&lt;/b&gt; Stacked QP over horizon N=25 (1.0s, dt=0.04s), terminal cost Pf = PDARE&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Hard box constraints: 5N ≤ T ≤ 25N, |τ| ≤ 0.5 N·m (solve time: 0.42 ms)&lt;br/&gt;• &lt;b&gt;Actuation synthesis (Block 10 - output):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;uk = utrim + u0* ➔ maps to body velocity / wrench cmd_vel&lt;br/&gt;&amp;nbsp;&amp;nbsp;Publishes controller_type = MODEL_2_DMDC_MPC or LQR&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="864" y="592" width="456" height="290" as="geometry" /></mxCell><mxCell id="col5_lane" value="&lt;b style='color:#B45309;font-size:12px;'&gt;5. COMMON BACK-END &amp;amp; SAFETY&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=6;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#B45309;fontSize=11;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1346" y="86" width="270" height="926" as="geometry" /></mxCell><mxCell id="c5_arb" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;🔀 Pilot / autonomy arbitration&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;• Stick deflection &amp;gt; 0.02 ➔ Manual priority:&lt;br/&gt;&amp;nbsp;&amp;nbsp;Passes pilot velocity (base_link) directly&lt;br/&gt;• Stick centered ➔ Autonomous setpoint:&lt;br/&gt;&amp;nbsp;&amp;nbsp;Station-keeping hover lock at current pos&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1358" y="122" width="246" height="95" as="geometry" /></mxCell><mxCell id="c5_safety" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;🛡️ SafetyManager - validate cmd&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;• NaN / Inf ➔ zero command&lt;br/&gt;• Clamps velocity ≤ 1.0 m/s&lt;br/&gt;• Zero lateral drift if Z &amp;lt; 1.5m on takeoff&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1358" y="227" width="246" height="85" as="geometry" /></mxCell><mxCell id="c5_flight" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;✈️ FlightManager (state machine)&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;• States: INIT ➔ ARMED ➔ TAKEOFF ➔ GUIDED ➔ HOVER ➔ LAND&lt;br/&gt;• Position tolerance: 0.05m | Vel tol: 0.05m/s&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1358" y="322" width="246" height="85" as="geometry" /></mxCell><mxCell id="c5_dec_gate" value="&lt;b&gt;Airborne gate?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:8.5px;'&gt;altitude Z ≥ 0.50m?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#EAB308;strokeWidth=1.5;fontColor=#854D0E;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1421" y="420" width="120" height="65" as="geometry" /></mxCell><mxCell id="c5_gate_no" value="&lt;div style='font-size:10px;font-weight:700;color:#DC2626;'&gt;🛑 NO - hold velocity commands&lt;/div&gt;&lt;div style='font-size:8.5px;color:#991B1B;line-height:12px;margin-top:2px;'&gt;Drone on ground (Z &amp;lt; 0.50m). Pauses cmd_vel&lt;br/&gt;to allow clean MAVLink climb without windup.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1358" y="495" width="246" height="55" as="geometry" /></mxCell><mxCell id="c5_gate_yes" value="&lt;div style='font-size:10px;font-weight:700;color:#059669;'&gt;✅ YES - send command&lt;/div&gt;&lt;div style='font-size:8.5px;color:#065F46;line-height:12px;margin-top:2px;'&gt;Continuous &lt;code&gt;TwistStamped&lt;/code&gt; sent to&lt;br/&gt;&lt;code&gt;/ap/v1/cmd_vel&lt;/code&gt; @ 50 Hz (map or base_link)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1358" y="560" width="246" height="55" as="geometry" /></mxCell><mxCell id="c5_telem" value="&lt;div style='font-size:11px;font-weight:700;color:#0F172A;'&gt;📈 Telemetry &amp;amp; logging (50 Hz)&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;line-height:13.5px;margin-top:3px;'&gt;• &lt;code&gt;/drones_controller/position_error&lt;/code&gt; (XYZ error)&lt;br/&gt;• &lt;code&gt;/drones_controller/desired_attitude&lt;/code&gt; (Quat)&lt;br/&gt;• &lt;code&gt;/drones_controller/controller_type&lt;/code&gt; (Model id)&lt;br/&gt;• Live EKF covariance trace &amp;amp; DMDc residual&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1358" y="625" width="246" height="95" as="geometry" /></mxCell><mxCell id="col6_lane" value="&lt;b style='color:#0F766E;font-size:12px;'&gt;6. OUTPUTS, SITL &amp;amp; DEPLOYMENT&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=6;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.5;fontColor=#0F766E;fontSize=11;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1630" y="86" width="270" height="926" as="geometry" /></mxCell><mxCell id="c6_srv" value="&lt;div style='font-size:11px;font-weight:700;color:#0F766E;'&gt;🔌 ArduPilot services &amp;amp; MAVLink&lt;/div&gt;&lt;div style='font-size:9.5px;color:#134E4A;line-height:13.5px;margin-top:3px;'&gt;• Service clients: /ap/arm_motors, /ap/mode_switch&lt;br/&gt;• /ap/takeoff (MAVLink guided climb to 5.0m)&lt;br/&gt;• Interacts with MAVLink flight modes&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#14B8A6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1642" y="122" width="246" height="85" as="geometry" /></mxCell><mxCell id="c6_gz" value="&lt;div style='font-size:11px;font-weight:700;color:#0F766E;'&gt;🌐 ArduPilot SITL ➔ Gazebo Harmonic&lt;/div&gt;&lt;div style='font-size:9.5px;color:#134E4A;line-height:13.5px;margin-top:3px;'&gt;• Mixer matrix Γ converts [T; τ] to motor RPM&lt;br/&gt;• Gazebo Harmonic Iris model physics simulation&lt;br/&gt;• Multi-body dynamics, brushless motor models&lt;br/&gt;• ArduPilot EKF3 updates filtered state @ 50 Hz&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#14B8A6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1642" y="217" width="246" height="100" as="geometry" /></mxCell><mxCell id="c6_dash" value="&lt;div style='font-size:11px;font-weight:700;color:#0F766E;'&gt;🖥️ Ground Station &amp;amp; Dashboard&lt;/div&gt;&lt;div style='font-size:9.5px;color:#134E4A;line-height:13.5px;margin-top:3px;'&gt;• Web Dashboard at &lt;code&gt;http://localhost:8000&lt;/code&gt;&lt;br/&gt;• Three.js 3D attitude visualizer, live gyro&lt;br/&gt;• 30 FPS MJPEG camera video stream&lt;br/&gt;• Live 8BitDo gamepad stick deflection HUD&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#14B8A6;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1642" y="327" width="246" height="95" as="geometry" /></mxCell><mxCell id="c6_where" value="&lt;div style='font-size:11.5px;font-weight:800;color:#0F766E;'&gt;📍 WHERE IT IS USED &amp;amp; DEPLOYED&lt;/div&gt;&lt;div style='font-size:9.5px;color:#134E4A;line-height:14px;margin-top:3px;'&gt;• &lt;b&gt;Autonomous Waypoint Tracking:&lt;/b&gt; Precision real-time trajectory following in GPS-denied or GPS environments.&lt;br/&gt;• &lt;b&gt;Controller Benchmarking:&lt;/b&gt; Side-by-side performance comparison of classical geometric SO(3) vs data-driven optimal control (DMDc+LQR/MPC).&lt;br/&gt;• &lt;b&gt;Hardware Deployment:&lt;/b&gt; Companion computers (NVIDIA Jetson Orin Nano, Raspberry Pi 4/5) paired with Pixhawk/Cube Orange+ FCU.&lt;br/&gt;• &lt;b&gt;Inter-Process Comms:&lt;/b&gt; FastRTPS / CycloneDDS shared memory.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1642" y="432" width="246" height="210" as="geometry" /></mxCell><mxCell id="c6_end" value="&lt;b&gt;END&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1730" y="655" width="70" height="32" as="geometry" /></mxCell><mxCell id="footer_bar" value="&lt;div style='font-size:10.5px;color:#334155;text-align:center;line-height:16px;'&gt;&lt;b&gt;SYSTEM METRICS &amp;amp; VERIFICATION:&lt;/b&gt; &lt;span style='color:#059669;font-weight:700;'&gt;✓ 15/15 Automated Unit Tests Passing&lt;/span&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;Lie Group SO(3) Error:&lt;/b&gt; 6.3×10⁻¹⁷ &amp;nbsp;|&amp;nbsp; &lt;b&gt;DARE Convergence:&lt;/b&gt; 5.2×10⁻⁸ &amp;nbsp;|&amp;nbsp; &lt;b&gt;MPC QP Solve Time:&lt;/b&gt; 0.42 ms &amp;nbsp;|&amp;nbsp; &lt;b&gt;Control Loop Frequency:&lt;/b&gt; 50.0 Hz Real-Time &amp;nbsp;|&amp;nbsp; &lt;b&gt;Takeoff Protection Gate:&lt;/b&gt; Z ≥ 0.50m Active&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;stroke