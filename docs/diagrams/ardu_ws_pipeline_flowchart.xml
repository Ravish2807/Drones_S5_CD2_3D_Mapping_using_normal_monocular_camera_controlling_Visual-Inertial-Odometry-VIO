<mxfile host="app.diagrams.net" modified="2026-10-20T18:55:00.000Z" agent="Antigravity" version="24.0.0" type="device"><diagram id="ardu_ws_pipeline" name="ardu_ws End-to-End Drone Pipeline"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry" /></mxCell><mxCell id="header" value="&lt;div style='font-size:24px;font-weight:800;color:#0F172A;letter-spacing:-0.5px;margin-bottom:4px;'&gt;🚀 AUTONOMOUS DRONE FLIGHT CONTROL &amp;amp; SIMULATION PIPELINE&lt;/div&gt;&lt;div style='font-size:12px;color:#475569;font-weight:500;'&gt;End-to-End System Architecture: Gazebo Harmonic SITL ➔ ArduPilot AP_DDS ➔ 3 Interchangeable Controllers ➔ Actuation &amp;amp; Web Teleoperation&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=25;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="75" as="geometry" /></mxCell><mxCell id="badges" value="&lt;div style='text-align:right;font-size:11px;font-weight:600;line-height:22px;'&gt;&lt;span style='background:#E0E7FF;color:#3730A3;padding:4px 10px;border-radius:6px;margin:2px;'&gt;ROS 2 Humble&lt;/span&gt; &lt;span style='background:#E0F2FE;color:#0369A1;padding:4px 10px;border-radius:6px;margin:2px;'&gt;Gazebo Harmonic&lt;/span&gt; &lt;span style='background:#FEF3C7;color:#92400E;padding:4px 10px;border-radius:6px;margin:2px;'&gt;ArduPilot AP_DDS&lt;/span&gt;&lt;br/&gt;&lt;span style='background:#ECFDF5;color:#065F46;padding:4px 10px;border-radius:6px;margin:2px;'&gt;8BitDo Bluetooth Gamepad&lt;/span&gt; &lt;span style='background:#F1F5F9;color:#334155;padding:4px 10px;border-radius:6px;margin:2px;'&gt;FastAPI Web Dashboard&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=right;spacingRight=20;shadow=1;" vertex="1" parent="1"><mxGeometry x="1400" y="20" width="480" height="75" as="geometry" /></mxCell><mxCell id="col1_lane" value="&lt;b style='color:#0369A1;font-size:14px;'&gt;📡 1. SIMULATION &amp;amp; SENSORS (INPUTS)&lt;/b&gt;" style="swimlane;startSize=36;rounded=1;arcSize=6;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="870" as="geometry" /></mxCell><mxCell id="c1_sitl" value="&lt;div style='font-size:12px;font-weight:700;color:#0369A1;margin-bottom:4px;'&gt;🌐 Gazebo Harmonic SITL (gz-sim 8)&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• World: &lt;b&gt;runway.sdf&lt;/b&gt; (Runway physics, GPS/IMU)&lt;br/&gt;• Model: &lt;b&gt;Iris Quadcopter&lt;/b&gt; + 3-Axis Gimbal&lt;br/&gt;• Motor constant: k&lt;sub&gt;f&lt;/sub&gt; = 8.55×10⁻⁶ N/(rad/s)²&lt;br/&gt;• Real-time multi-body flight dynamics&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#BAE6FD;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="160" width="300" height="105" as="geometry" /></mxCell><mxCell id="c1_sensors" value="&lt;div style='font-size:12px;font-weight:700;color:#0369A1;margin-bottom:4px;'&gt;📊 Sensor Feedback Streams (ROS 2)&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:15px;'&gt;• &lt;b&gt;/ap/pose&lt;/b&gt; (50 Hz, ENU map):&lt;br/&gt;&amp;nbsp;&amp;nbsp;Position [x, y, z] &amp;amp; Quat [q&lt;sub&gt;x&lt;/sub&gt;, q&lt;sub&gt;y&lt;/sub&gt;, q&lt;sub&gt;z&lt;/sub&gt;, q&lt;sub&gt;w&lt;/sub&gt;]&lt;br/&gt;• &lt;b&gt;/ap/twist&lt;/b&gt; (50 Hz, FLU body):&lt;br/&gt;&amp;nbsp;&amp;nbsp;Linear vel [v&lt;sub&gt;x&lt;/sub&gt;, v&lt;sub&gt;y&lt;/sub&gt;, v&lt;sub&gt;z&lt;/sub&gt;] &amp;amp; Body rates [p, q, r]&lt;br/&gt;• &lt;b&gt;/ap/v1/status&lt;/b&gt; (10 Hz): Arm &amp;amp; EKF3 status&lt;br/&gt;• &lt;b&gt;/camera/image_raw&lt;/b&gt; (30 FPS): Monocular RGB&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#BAE6FD;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="285" width="300" height="145" as="geometry" /></mxCell><mxCell id="c1_teleop" value="&lt;div style='font-size:12px;font-weight:700;color:#0284C7;margin-bottom:4px;'&gt;🎮 8BitDo Ultimate 2C Gamepad&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;Left Stick:&lt;/b&gt; Throttle (V&lt;sub&gt;z&lt;/sub&gt;) &amp;amp; Yaw Rate (ψ̇)&lt;br/&gt;• &lt;b&gt;Right Stick:&lt;/b&gt; Pitch (V&lt;sub&gt;x&lt;/sub&gt;) &amp;amp; Roll (V&lt;sub&gt;y&lt;/sub&gt;) [Axes 2&amp;amp;5]&lt;br/&gt;• &lt;b&gt;Buttons:&lt;/b&gt; Y=GUIDED, A=ARM, X=TAKEOFF 5M&lt;br/&gt;• &lt;b&gt;Modifiers:&lt;/b&gt; LB=Precision (0.5m/s), RB=Turbo (2m/s)&lt;br/&gt;• &lt;b&gt;Button B:&lt;/b&gt; Instant Brake / Hover Lock&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#BAE6FD;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="450" width="300" height="130" as="geometry" /></mxCell><mxCell id="c1_target" value="&lt;div style='font-size:12px;font-weight:700;color:#0284C7;margin-bottom:4px;'&gt;🎯 Autonomous Setpoint Target&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Topic: &lt;b&gt;/drones_controller/target_pose&lt;/b&gt;&lt;br/&gt;• Desired XYZ Position: [x&lt;sub&gt;d&lt;/sub&gt;, y&lt;sub&gt;d&lt;/sub&gt;, z&lt;sub&gt;d&lt;/sub&gt;] (ENU)&lt;br/&gt;• Desired Yaw: ψ&lt;sub&gt;d&lt;/sub&gt; | Default: [1.0, 0.0, 1.0] m&lt;br/&gt;• Dynamic Waypoint update from Web UI / Script&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#BAE6FD;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="600" width="300" height="110" as="geometry" /></mxCell><mxCell id="c1_rosgz" value="&lt;div style='font-size:12px;font-weight:700;color:#0369A1;margin-bottom:4px;'&gt;🌉 ros_gz_bridge &amp;amp; Camera Link&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Bridges Gazebo camera sensor to ROS 2&lt;br/&gt;• Gz topic ➔ /camera/image_raw&lt;br/&gt;• Subscribes gimbal pitch/yaw command topics&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#BAE6FD;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="730" width="300" height="95" as="geometry" /></mxCell><mxCell id="col2_lane" value="&lt;b style='color:#B45309;font-size:14px;'&gt;🛡️ 2. COMMS &amp;amp; ARBITRATION&lt;/b&gt;" style="swimlane;startSize=36;rounded=1;arcSize=6;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#B45309;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="310" height="870" as="geometry" /></mxCell><mxCell id="c2_dds" value="&lt;div style='font-size:12px;font-weight:700;color:#B45309;margin-bottom:4px;'&gt;⚡ AP_DDS &amp;amp; Micro-ROS Agent&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Embedded XRCE client in ArduPilot SITL&lt;br/&gt;• UDP localhost:2019 transport&lt;br/&gt;• Zero-latency ROS 2 topic &amp;amp; service bridge&lt;br/&gt;• Native DDS serialization (FastRTPS)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FDE68A;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="405" y="160" width="280" height="110" as="geometry" /></mxCell><mxCell id="c2_gate" value="&lt;div style='font-size:12px;font-weight:700;color:#B45309;margin-bottom:4px;'&gt;🛑 Takeoff Safety Gate (Z ≥ 0.50m)&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;Ground State (Z &amp;lt; 0.50m):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Pauses velocity tracking commands.&lt;br/&gt;&amp;nbsp;&amp;nbsp;Allows clean MAVLink 5.0m climb without&lt;br/&gt;&amp;nbsp;&amp;nbsp;motor windup or ground tipping.&lt;br/&gt;• &lt;b&gt;Airborne State (Z ≥ 0.50m):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Engages full closed-loop SO(3) tracking.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="405" y="300" width="280" height="150" as="geometry" /></mxCell><mxCell id="c2_arbiter" value="&lt;div style='font-size:12px;font-weight:700;color:#B45309;margin-bottom:4px;'&gt;🔀 Stick Teleop Priority Arbiter&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;Priority 1: Stick Deflection Active&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Direct body-frame command (base_link):&lt;br/&gt;&amp;nbsp;&amp;nbsp;[V&lt;sub&gt;x&lt;/sub&gt;, V&lt;sub&gt;y&lt;/sub&gt;, V&lt;sub&gt;z&lt;/sub&gt;, ψ̇] overrides autonomous path.&lt;br/&gt;• &lt;b&gt;Priority 2: Sticks Centered (Neutral)&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Instant station-keeping hover lock.&lt;br/&gt;&amp;nbsp;&amp;nbsp;Continually captures current (x,y,z) setpoint.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FDE68A;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="405" y="480" width="280" height="150" as="geometry" /></mxCell><mxCell id="c2_failsafe" value="&lt;div style='font-size:12px;font-weight:700;color:#B45309;margin-bottom:4px;'&gt;🚨 Safety Watchdog &amp;amp; Limits&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Sensor timeout watchdog (0.20s threshold)&lt;br/&gt;• NaN / Inf input sanitization &amp;amp; zeroing&lt;br/&gt;• Max velocity saturation clamp: 1.0 m/s&lt;br/&gt;• Max tilt angle constraint: 20°&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FDE68A;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="405" y="660" width="280" height="120" as="geometry" /></mxCell><mxCell id="col3_lane" value="&lt;b style='color:#4338CA;font-size:14px;'&gt;🧠 3. CORE FLIGHT CONTROLLER ENGINE (3 Interchangeable Models)&lt;/b&gt;" style="swimlane;startSize=36;rounded=1;arcSize=6;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#4338CA;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="480" height="870" as="geometry" /></mxCell><mxCell id="c3_selector" value="&lt;div style='font-size:11px;font-weight:700;color:#3730A3;text-align:center;'&gt;Runtime Launcher: &lt;code&gt;ros2 launch drones_controller controller.launch.py model:=0|1|2 mode:=mpc|lqr&lt;/code&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;align=center;" vertex="1" parent="1"><mxGeometry x="735" y="155" width="450" height="32" as="geometry" /></mxCell><mxCell id="m0_box" value="&lt;div style='font-size:12px;font-weight:800;color:#1E1B4B;margin-bottom:3px;'&gt;🔹 MODEL 0: Baseline Cascaded SO(3) Controller &lt;span style='background:#E0E7FF;color:#3730A3;font-size:9px;padding:2px 6px;border-radius:4px;'&gt;controller_node (50 Hz)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;Outer Loop:&lt;/b&gt; Position error e&lt;sub&gt;p&lt;/sub&gt; = p&lt;sub&gt;d&lt;/sub&gt; - p, Velocity error e&lt;sub&gt;v&lt;/sub&gt; = v&lt;sub&gt;d&lt;/sub&gt; - v&lt;br/&gt;&amp;nbsp;&amp;nbsp;Virtual commanded acceleration: a&lt;sub&gt;d&lt;/sub&gt; = p̈&lt;sub&gt;d&lt;/sub&gt; + K&lt;sub&gt;p&lt;/sub&gt; e&lt;sub&gt;p&lt;/sub&gt; + K&lt;sub&gt;v&lt;/sub&gt; e&lt;sub&gt;v&lt;/sub&gt;&lt;br/&gt;• &lt;b&gt;Attitude Generator:&lt;/b&gt; Desired force F&lt;sub&gt;d&lt;/sub&gt; = m(a&lt;sub&gt;d&lt;/sub&gt; - g) ➔ Desired thrust axis b&lt;sub&gt;3d&lt;/sub&gt; = F&lt;sub&gt;d&lt;/sub&gt; / ||F&lt;sub&gt;d&lt;/sub&gt;||&lt;br/&gt;&amp;nbsp;&amp;nbsp;Orthonormal rotation matrix R&lt;sub&gt;d&lt;/sub&gt; = [b&lt;sub&gt;1d&lt;/sub&gt;, b&lt;sub&gt;2d&lt;/sub&gt;, b&lt;sub&gt;3d&lt;/sub&gt;] ∈ SO(3)&lt;br/&gt;• &lt;b&gt;Inner Loop:&lt;/b&gt; Geometric attitude error e&lt;sub&gt;R&lt;/sub&gt; = ½(R&lt;sub&gt;d&lt;/sub&gt;ᵀ R - Rᵀ R&lt;sub&gt;d&lt;/sub&gt;)&lt;sup&gt;∨&lt;/sup&gt;, rate error e&lt;sub&gt;ω&lt;/sub&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Control torque: τ = -K&lt;sub&gt;R&lt;/sub&gt; e&lt;sub&gt;R&lt;/sub&gt; - K&lt;sub&gt;Ω&lt;/sub&gt; e&lt;sub&gt;ω&lt;/sub&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#A5B4FC;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="735" y="200" width="450" height="160" as="geometry" /></mxCell><mxCell id="m1_box" value="&lt;div style='font-size:12px;font-weight:800;color:#581C87;margin-bottom:3px;'&gt;🟣 MODEL 1: Nonlinear Model-Based &amp;amp; Geometric SO(3) &lt;span style='background:#F3E8FF;color:#6B21A8;font-size:9px;padding:2px 6px;border-radius:4px;'&gt;model1_so3_controller (50 Hz)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;12-State Error-State EKF (Block 4):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Error state δx = [δp, δv, δθ, δω]ᵀ ∈ ℝ¹² with Lie manifold addition R ← R·Exp(δθ)&lt;br/&gt;&amp;nbsp;&amp;nbsp;Exact Rodrigues Exp &amp;amp; Log mappings (machine precision 6.3×10⁻¹⁷)&lt;br/&gt;&amp;nbsp;&amp;nbsp;Joseph-form covariance stabilization P ← (I - KH)P(I - KH)ᵀ + KRₙKᵀ&lt;br/&gt;• &lt;b&gt;Outer-Loop Guidance (Blocks 5 &amp;amp; 6):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Desired force F&lt;sub&gt;d&lt;/sub&gt; = m(a&lt;sub&gt;d&lt;/sub&gt; - g) ➔ Projection onto body frame: T = F&lt;sub&gt;d&lt;/sub&gt; · (Re₃)&lt;br/&gt;• &lt;b&gt;Geometric SO(3) Attitude Control (Block 7):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Singularity-free large-angle tracking (&amp;gt;90° tilt capability):&lt;br/&gt;&amp;nbsp;&amp;nbsp;τ = -K&lt;sub&gt;R&lt;/sub&gt; e&lt;sub&gt;R&lt;/sub&gt; - K&lt;sub&gt;Ω&lt;/sub&gt; e&lt;sub&gt;ω&lt;/sub&gt; + ω × Jω&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="735" y="380" width="450" height="220" as="geometry" /></mxCell><mxCell id="m2_box" value="&lt;div style='font-size:12px;font-weight:800;color:#064E3B;margin-bottom:3px;'&gt;🟢 MODEL 2: Data-Driven DMDc &amp;amp; Optimal Control (LQR/MPC) &lt;span style='background:#D1FAE5;color:#047857;font-size:9px;padding:2px 6px;border-radius:4px;'&gt;model2_dmdc_controller (25 Hz)&lt;/span&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;DMDc Identification (Blocks 1 &amp;amp; 2):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Online snapshot regression [A B] = X⁺ [X; U]&lt;sup&gt;†&lt;/sup&gt; over rolling flight data&lt;br/&gt;&amp;nbsp;&amp;nbsp;Blended with analytical continuous hover linearization prior (A&lt;sub&gt;phys&lt;/sub&gt;, B&lt;sub&gt;phys&lt;/sub&gt;)&lt;br/&gt;• &lt;b&gt;LQR Branch (Blocks 3–6):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;DARE Riccati recursion: P = AᵀPA - AᵀPB(R + BᵀPB)⁻¹BᵀPA + Q&lt;br/&gt;&amp;nbsp;&amp;nbsp;Optimal feedback gain K = (R + BᵀPB)⁻¹BᵀPA ∈ ℝ⁴ˣ¹² ➔ u = -K x&lt;sub&gt;k&lt;/sub&gt;&lt;br/&gt;• &lt;b&gt;Constrained QP MPC Branch (Blocks 7–9):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Stacked QP over horizon N=25 (1.0s, dt=0.04s) with terminal weight P&lt;sub&gt;f&lt;/sub&gt; = P&lt;sub&gt;DARE&lt;/sub&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Hard box constraints: 5N ≤ T ≤ 25N, |τ| ≤ 0.5 N·m (solve time: 0.42 ms)&lt;br/&gt;• &lt;b&gt;Actuation (Block 10):&lt;/b&gt; u&lt;sub&gt;k&lt;/sub&gt; = u&lt;sub&gt;trim&lt;/sub&gt; + u&lt;sub&gt;0&lt;/sub&gt;* (Receding horizon)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="735" y="620" width="450" height="260" as="geometry" /></mxCell><mxCell id="col4_lane" value="&lt;b style='color:#BE123C;font-size:14px;'&gt;⚙️ 4. ACTUATION &amp;amp; ALLOCATION&lt;/b&gt;" style="swimlane;startSize=36;rounded=1;arcSize=6;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#BE123C;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="310" height="870" as="geometry" /></mxCell><mxCell id="c4_cmd" value="&lt;div style='font-size:12px;font-weight:700;color:#BE123C;margin-bottom:4px;'&gt;🚀 Actuation Command Interface&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Topic: &lt;b&gt;/ap/v1/cmd_vel&lt;/b&gt;&lt;br/&gt;• Type: &lt;b&gt;geometry_msgs/TwistStamped&lt;/b&gt;&lt;br/&gt;• Rate: 50.0 Hz continuous stream&lt;br/&gt;• Frame: &lt;b&gt;map&lt;/b&gt; (autonomous position hold)&lt;br/&gt;&amp;nbsp;&amp;nbsp;or &lt;b&gt;base_link&lt;/b&gt; (manual stick flight)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FECDD3;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="1235" y="160" width="280" height="120" as="geometry" /></mxCell><mxCell id="c4_mixer" value="&lt;div style='font-size:12px;font-weight:700;color:#BE123C;margin-bottom:4px;'&gt;🔄 Control Allocation &amp;amp; Mixing&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Mixer matrix Γ converts wrench [T; τ] to&lt;br/&gt;&amp;nbsp;&amp;nbsp;individual rotor thrusts: f&lt;sub&gt;i&lt;/sub&gt; = k&lt;sub&gt;f&lt;/sub&gt; Ω&lt;sub&gt;i&lt;/sub&gt;²&lt;br/&gt;• Motor speeds: Ω&lt;sub&gt;i&lt;/sub&gt; = √(Γ⁻¹u&lt;sub&gt;i&lt;/sub&gt; / k&lt;sub&gt;f&lt;/sub&gt;)&lt;br/&gt;• Clipped to physical limits [Ω&lt;sub&gt;min&lt;/sub&gt;, Ω&lt;sub&gt;max&lt;/sub&gt;]&lt;br/&gt;• Quad-X brushless ESC motor signals&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FECDD3;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="1235" y="305" width="280" height="130" as="geometry" /></mxCell><mxCell id="c4_services" value="&lt;div style='font-size:12px;font-weight:700;color:#BE123C;margin-bottom:4px;'&gt;🔌 ArduPilot MAVLink Services&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• &lt;b&gt;/ap/arm_motors:&lt;/b&gt; Motor arm/disarm&lt;br/&gt;• &lt;b&gt;/ap/mode_switch:&lt;/b&gt; Mode switch (GUIDED/LAND)&lt;br/&gt;• &lt;b&gt;/ap/takeoff:&lt;/b&gt; MAVLink climb to 5.0m&lt;br/&gt;• &lt;b&gt;/ap/prearm_check:&lt;/b&gt; Compass &amp;amp; EKF prearm&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FECDD3;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="1235" y="460" width="280" height="115" as="geometry" /></mxCell><mxCell id="c4_loopback" value="&lt;div style='font-size:12px;font-weight:700;color:#BE123C;margin-bottom:4px;'&gt;🔁 Closed-Loop SITL Feedback&lt;/div&gt;&lt;div style='font-size:10px;color:#334155;line-height:14px;'&gt;• Motor forces apply to Iris frame in Gazebo&lt;br/&gt;• Physics updates rigid body accelerations&lt;br/&gt;• EKF3 updates states at next timestep k+1&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wr